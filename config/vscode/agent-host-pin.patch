+
+// The shared SSH path must never run an unsigned source-built command-shell.
+fn is_agent_command(cli: &args::AnyCli) -> bool {
+	matches!(&cli.core().subcommand, Some(args::Commands::Agent(_)))
+}
+
+#[test]
+fn coordinated_cli_accepts_only_agent_commands() {
+	for (argv, expected) in [
+		(vec!["code", "agent", "endpoints"], true),
+		(
+			vec![
+				"code",
+				"--cli-data-dir",
+				"/tmp/cli",
+				"--telemetry-level",
+				"off",
+				"agent",
+				"host",
+			],
+			true,
+		),
+		(vec!["code", "command-shell"], false),
+		(
+			vec!["code", "--cli-data-dir", "agent", "command-shell"],
+			false,
+		),
+		(vec!["code", "tunnel"], false),
+	] {
+		let cli = args::AnyCli::Standalone(args::StandaloneCli::try_parse_from(argv).unwrap());
+		assert_eq!(is_agent_command(&cli), expected);
+	}
+}
